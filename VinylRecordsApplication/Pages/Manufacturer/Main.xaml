<Page x:Class="VinylRecordsApplication.Pages.Manufacturer.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:VinylRecordsApplication.Pages.Manufacturer"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="Main">

    <Grid Background="#FFE6E6E6">
        <!-- Элемент ScrollViewer Позволяет прокручивать список элементов -->
        <ScrollViewer Margin="10,10,10,10">
            <!-- Элемент StackPanel Позволяет создавать списки в вертикальном порядке -->
            <StackPanel x:Name="manufactureParent" Margin="10">
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>